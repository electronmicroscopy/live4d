# Live scans (live4d.live): the pipeline image plus quantem.gpu (LiveEncoder, ANS) and quantem.widget
# (Show4DSTEM), each pinned to one commit. Build from the repository root:
#   docker build -f docker/Dockerfile.holoscan --target pipeline -t live4d:pipeline .
#   docker build -f docker/Dockerfile.live -t live4d:live .
ARG PIPELINE_IMAGE=live4d:pipeline
FROM ${PIPELINE_IMAGE}

ARG QUANTEM_GPU_COMMIT=96d58fb
ARG QUANTEM_WIDGET_COMMIT=c33dc1b

# PyTorch for CUDA 13 (the base image's CUDA); the sink hands frames over on Holoscan's stream with it.
RUN --mount=type=secret,id=build_resolv,target=/etc/resolv.conf,mode=0444 \
    python3 -m pip install --no-cache-dir torch --index-url https://download.pytorch.org/whl/cu130 \
 && python3 -m pip install --no-cache-dir \
      "quantem.gpu[stream] @ git+https://github.com/bobleesj/quantem.gpu.git@${QUANTEM_GPU_COMMIT}" \
      "quantem.widget @ git+https://github.com/bobleesj/quantem.widget.git@${QUANTEM_WIDGET_COMMIT}" \
      jupyterlab ipykernel voila \
 && python3 -c "import torch, cupy; from quantem.gpu.streaming import LiveEncoder; import quantem.widget; print('torch', torch.__version__)"
