FROM nvcr.io/nvidia/clara-holoscan/holoscan:v4.4.0-cuda13

ARG CUDA_ARCHITECTURES=86;89

ENV DEBIAN_FRONTEND=noninteractive
ENV CMAKE_PREFIX_PATH=/opt/nvidia/holoscan

RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    git \
    libzmq3-dev \
    ninja-build \
    pkg-config \
    python3-dev \
    python3-pip \
  && rm -rf /var/lib/apt/lists/*

RUN python3 -m pip install --no-cache-dir \
    "pybind11<3" \
    pyyaml

WORKDIR /opt/dectris/stanford-dectris-nvidia-4d-stem

COPY holoscan_pipeline ./holoscan_pipeline

RUN cmake -S holoscan_pipeline -B build/holoscan_pipeline -G Ninja \
      -DCMAKE_BUILD_TYPE=Release \
      -DCMAKE_CUDA_ARCHITECTURES="${CUDA_ARCHITECTURES}" \
      -Dpybind11_DIR="$(python3 -m pybind11 --cmakedir)" \
  && cmake --build build/holoscan_pipeline

ENV PYTHONPATH=/opt/dectris/stanford-dectris-nvidia-4d-stem/build/holoscan_pipeline/python:/opt/nvidia/holoscan/python/lib:/opt/nvidia/hololink/python
ENV LD_LIBRARY_PATH=/opt/nvidia/holoscan/lib:/usr/local/cuda/compat/lib:/usr/local/nvidia/lib:/usr/local/nvidia/lib64

ENTRYPOINT ["python3", "-m", "dectris_holoscan"]
CMD ["--config", "/opt/dectris/stanford-dectris-nvidia-4d-stem/holoscan_pipeline/config/basic_ingest.yaml"]
