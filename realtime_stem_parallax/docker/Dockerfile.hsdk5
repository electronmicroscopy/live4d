# syntax=docker/dockerfile:1
# The Holoscan SDK 5 runtime image (CUDA 13): NVIDIA's public Holoscan 5 base + this repository's
# shared ingest (holoscan_pipeline/ and dectris/ at the repository root: ZMQ with bslz4, and
# imagemux RDMA without compression) + a CUDA 13 build of PyTorch for the reconstruction.
# Build from the REPOSITORY ROOT (one level above this folder), because it needs those folders:
#
#   docker build -f realtime_stem_parallax/docker/Dockerfile.hsdk5 -t realtime-stem:hsdk5 .
#
# CUDA_ARCHITECTURES lists the GPU generations the kernels are compiled for: 89 = Ada (RTX 6000
# Ada), 90 = Hopper (H100/H200), 120 = Blackwell workstation/server (RTX PRO 6000).
# The Holoscan 4 image (docker/Dockerfile) is unchanged and still builds from this folder.
FROM nvcr.io/nvidia/clara-holoscan/holoscan:v5.0.0-cuda13@sha256:faa23a3a2479697fd64babcb27d28cf97f21d5da54d65c92225f8a9b0d99264a

ARG CUDA_ARCHITECTURES=86;89;90;120

ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update && apt-get install -y --no-install-recommends \
      build-essential pkg-config libzmq3-dev libnvcomp5-dev-cuda-13 libhdf5-dev ninja-build python3-dev \
      python3-pip libibverbs-dev rdma-core ibverbs-providers ibverbs-utils \
    && rm -rf /var/lib/apt/lists/*

# The same PyTorch version as the Holoscan 4 image (2.11), built for CUDA 13.
RUN python3 -m pip install --no-cache-dir \
      torch==2.11.0+cu130 --index-url https://download.pytorch.org/whl/cu130
# lz4 + dectris-compression: the pure-Python ingest (reading .dstream recordings) and its tests.
RUN python3 -m pip install --no-cache-dir \
      "numpy>=2.1,<3" pyyaml cbor2 cupy-cuda13x pyzmq pytest h5py hdf5plugin lz4 dectris-compression

WORKDIR /opt/live4d
COPY holoscan_pipeline ./holoscan_pipeline
COPY dectris ./dectris
RUN python3 -m pip install --no-cache-dir ./dectris
RUN cmake -S holoscan_pipeline -B build/holoscan_pipeline -G Ninja \
      -DCMAKE_BUILD_TYPE=Release -DCMAKE_CUDA_ARCHITECTURES="${CUDA_ARCHITECTURES}" \
    && cmake --build build/holoscan_pipeline --parallel 8

ENV PYTHONPATH=/opt/live4d/build/holoscan_pipeline/python:${PYTHONPATH}
# The repository is bind-mounted at run time: don't leave root-owned __pycache__ folders in it.
ENV PYTHONDONTWRITEBYTECODE=1
